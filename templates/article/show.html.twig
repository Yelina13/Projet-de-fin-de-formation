{% extends 'base.html.twig' %}

{% block title %}Article{% endblock %}

{% block body %}
    <h1>Article</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ article.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ article.title }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td><img src="{{ article.image }}" style="width:20%"></td>
            </tr>
            <tr>
                <th>Aperçu</th>
                <td>{{ article.overview }}</td>
            </tr>
            <tr>
                <th>Contenu</th>
                <td>{{ article.content }}</td>
            </tr>
            <tr>
                <th>Date de publication</th>
                <td>{{ article.publishedDate ? article.publishedDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Dernière mise à jour</th>
                <td>{{ article.updatedDate ? article.updatedDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_article_edit', {'id': article.id}) }}"class="btn btn-success mb-2">Editer</a>

      <br>

     <a href="{{ path('app_article_index') }}"class="btn btn-primary mb-2">Retourner à la liste</a>

    {{ include('article/_delete_form.html.twig') }}
{% endblock %}
