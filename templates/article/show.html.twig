{% extends 'base.html.twig' %}

{% block title %}Article{% endblock %}

{% block body %}
    <h1>Articles</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ article.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ article.title }}</td>
            </tr>
            <tr>
                <th>Overview</th>
                <td>{{ article.overview }}</td>
            </tr>
            <tr>
                <th>Content</th>
                <td>{{ article.content }}</td>
            </tr>
            <tr>
                <th>Published_date</th>
                <td>{{ article.publishedDate ? article.publishedDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_article_index') }}"class="btn btn-primary mb-2">Retourner à la liste</a>

    <br>

    <a href="{{ path('app_article_edit', {'id': article.id}) }}"class="btn btn-primary mb-2">Editer</a>

    {{ include('article/_delete_form.html.twig') }}
{% endblock %}
