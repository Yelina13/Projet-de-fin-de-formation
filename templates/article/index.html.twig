{% extends 'base.html.twig' %}

{% block title %}Article index{% endblock %}

{% block body %}
    <h1>Article index <a class="btn btn-success" href="{{ path('app_article_new') }}">Create new</a></h1>
    
{% for message in app.flashes('info') %}
<div class="alert alert-success">
{{ message }}
</div>
{% endfor %}

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>utilisateur</th>
                <th>Résumé</th>
                <th>Content</th>
                <th>Publié </th>
                <th>Visualiser</th>
                <th>Editer</th>
            </tr>
        </thead>
        <tbody>
        {% for article in articles %}
            <tr>
                <td>{{ article.id }}</td>
                <td>{{ article.title }}</td>
                <td>{{ article.publish }}</td>
                <td>{{ article.overview }}</td>
                <td>{{ article.content }}</td>
                <td>{{ article.publishedDate ? article.publishedDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a  href="{{ path('app_article_show', {'id': article.id}) }}"><i class="bi bi-eye-fill style" style="font-size: 2rem; color: green"></i></a>
                </td>
                <td>    
                    <a  href="{{ path('app_article_edit', {'id': article.id}) }}"><i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    
{% endblock %}
