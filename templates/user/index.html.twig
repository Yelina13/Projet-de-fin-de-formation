{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <h1>Liste des utilisateurs <a class="btn btn-success" href="{{ path('app_user_new') }}">Créer</a></h1>

    {% for message in app.flashes('info') %}
    <div class="alert alert-success">
    {{ message }}
    </div>
    {% endfor %}


    <table class="id" "table-hover" data-toggle="table" data-search="true"  >
        <thead>
            <tr>
                <th data-sortable="true" data-field="Id">Id</th>
                <th data-sortable="true" data-field="Pseudo">Pseudo</th>
                <th data-sortable="true" data-field="Email">Email</th>
                <th data-sortable="true" data-field="Rôles">Rôles</th>
                <th >Visualiser</th>
                <th>Editer</th>
                <th>Supprimer</th>

            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td style="width:3%;">{{ user.id }}</td>
                <td>{{ user.username }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
               
                <td style="width:3%;">
                    <a  href="{{ path('app_user_show', {'id': user.id}) }}"><i class="bi bi-eye-fill style" style="font-size: 2rem; color: green"  ></i></a>
                </td>
                <td style="width:3%;">    
                    <a  href="{{ path('app_user_edit', {'id': user.id}) }}"><i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
                </td>
                 <td style="width:3%;">
                 <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Souhaitez vous vraiment supprimer cette utilisateur ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button class="btn"><a  href="{{ path('app_user_edit', {'id': user.id}) }}"><i class="bi bi-trash " style="font-size: 2rem; color: green"></i></a></button>
                </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table><br>


<div class="d-flex justify-content-center">
{% do users.setPageRange(3) %}
{{knp_pagination_render(users, 'Utils/Pagination.html.twig')}}
</div>
    
{% endblock %}
