{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <h1>User index <a class="btn btn-success" href="{{ path('app_user_new') }}">Create new</a></h1>

    {% for message in app.flashes('info') %}
    <div class="alert alert-success">
    {{ message }}
    </div>
    {% endfor %}


    <table class="id="table" table-hover" data-toggle="table" data-search="true"  >
        <thead>
            <tr>
                <th data-sortable="true" data-field="Id">Id</th>
                <th data-sortable="true" data-field="Pseudo">Pseudo</th>
                <th data-sortable="true" data-field="Roles">Roles</th>
                <th data-sortable="true" data-field="Mot de passe">Mot de passe</th>
                <th >Visualiser</th>
                <th>Editer</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.username }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                <td>{{ user.password }}</td>
                <td>
                    <a  href="{{ path('app_user_show', {'id': user.id}) }}"><i class="bi bi-eye-fill style" style="font-size: 2rem; color: green"  ></i></a>
                </td>
                <td>    
                    <a  href="{{ path('app_user_edit', {'id': user.id}) }}"><i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table><br>


<div class="d-flex justify-content-center">
{% do users.setPageRange(3) %}
{{knp_pagination_render(users, 'Utils/Pagination.html.twig')}}
</div>
    
{% endblock %}
