{% extends 'base.html.twig' %}

{% block title %}Methodes d'affichage{% endblock %}
{% block body %}
<div class="btn-group btn-group-toggle" data-toggle="buttons">
  <label class="btn btn-secondary active">
    <input type="radio" name="options" data-toggle="button" id="option1" autocomplete="off" href="{{ path('app_sticker_index') }}" checked> par ID
  </label>
  <label class="btn btn-secondary">
    <input type="radio" name="options" data-toggle="button" id="option2" autocomplete="off" href=""> par nom
  </label>
  <label class="btn btn-secondary">
    <input type="radio" name="options" data-toggle="button" id="option3" autocomplete="off" href=""> par utilisateur
  </label>
</div>
{% endblock %}

{% block orderByNameASC %}
{% for sticker in stickers|sort((a, b) => a.id <=> b.id)|column('id') %}
            <tr>
                <td>{{ sticker.id }}</td>
                <td>{{ sticker.craft }}</td>
                <td>
                    {% for item in sticker.contains %}
                        {{ item }}
                    {% endfor %}
                </td>
                <td>
                        {{ sticker.isabout }}
                </td>
               <td>
                 <a  href="{{ path('app_sticker_show', {'id': sticker.id}) }}"><i class="bi bi-eye-fill" style="font-size: 2rem; color: green" ></i></a>
                 </td>
                <td>
                 <a  href="{{ path('app_sticker_edit', {'id': sticker.id}) }}"><i class="bi bi-pencil-square " style="font-size: 2rem; color: green"></i></a>
                </td>
           </tr>
        {% endfor %}
{% endblock %}