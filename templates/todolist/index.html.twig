{% extends 'base.html.twig' %}

{% block title %}Todolist index{% endblock %}

{% block body %}
    <h1>Todolist index <a class="btn btn-success" href="{{ path('app_todolist_new') }}">Create new</a></h1>

    {% for message in app.flashes('info') %}
    <div class="alert alert-success">
    {{ message }}
    </div>
    {% endfor %}


    <table class="id="table" table-hover " data-toggle="table" data-search="true"  >
        <thead>
            <tr>
                <th data-sortable="true" data-field="id">Id</th>
                <th data-sortable="true" data-field="Nom de la Todolist">Nom de la Todolist</th>
                <th data-sortable="true" data-field="Utilisateur">Utilisateur</th>
                <th>Visualiser</th>
                <th>Editer</th>
            </tr>
        </thead>
        <tbody>
        {% for todolist in todolists %}
            <tr>
                <td>{{ todolist.id }}</td>
                <td>{{ todolist.name }}</td>
                <td>{{ todolist.make }}</td>
                <td>
                    <a  href="{{ path('app_todolist_show', {'id': todolist.id}) }}"><i class="bi bi-eye-fill style" style="font-size: 2rem; color: green"  ></i></a>
                </td>
                <td>    
                    <a  href="{{ path('app_todolist_edit', {'id': todolist.id}) }}"><i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table> <br>


<div class="d-flex justify-content-center">
{% do todolists.setPageRange(3) %}
{{knp_pagination_render(todolists, 'Utils/Pagination.html.twig')}}
</div>

{% endblock %}
