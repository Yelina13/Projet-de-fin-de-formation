{% extends 'base.html.twig' %}

{% block title %}Todolist index{% endblock %}

{% block body %}
    <h1>Todolist index</h1>

    {% for message in app.flashes('info') %}
    <div class="alert alert-success">
    {{ message }}
    </div>
    {% endfor %}


    <table class="table ">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom de la Todolist</th>
                <th>Utilisateur</th>
                <th>Visualier</th>
                <th>Editer</th>
            </tr>
        </thead>
        <tbody>
        {% for todolist in todolists %}
            <tr>
                <td>{{ todolist.id }}</td>
                <td>{{ todolist.name }}</td>
                <td>{{ todolist.make }}</td>
                <td>
                    <a  href="{{ path('app_todolist_show', {'id': todolist.id}) }}"><i class="bi bi-eye-fill style" style="font-size: 2rem; color: green"  ></i></a>
                </td>
                <td>    
                    <a  href="{{ path('app_todolist_edit', {'id': todolist.id}) }}"><i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
<a class="btn btn-success" href="{{ path('app_todolist_new') }}">Create new</a>
{% endblock %}
