{% extends 'base.html.twig' %}

{% block title %}Todolist index
{% endblock %}

{% block body %}
	<h1>Todolist index</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>Show</th>
				<th>Edit</th>
			</tr>
		</thead>
		<tbody>
			{% for todolist in todolists %}
				<tr>
					<td>{{ todolist.id }}</td>
					<td>{{ todolist.name }}</td>
					<td>
						<a href="{{ path('app_todolist_show', {'id': todolist.id}) }}">
							<i class="bi bi-eye-fill style" style="font-size: 2rem; color: green"></i></a>
						</td>
					
					<td>
						<a href="{{ path('app_todolist_edit', {'id': todolist.id}) }}">
							<i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
						</td>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="3">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a class="btn btn-success" href="{{ path('app_todolist_new') }}">Create new</a>
{% endblock %}
