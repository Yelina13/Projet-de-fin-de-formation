{% extends 'base.html.twig' %}

{% block title %}Todolist{% endblock %}

{% block body %}
    <h1>Todolist</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ todolist.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ todolist.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_todolist_index') }}"class="btn btn-primary mb-2">back to list</a>

    <br>

    <a href="{{ path('app_todolist_edit', {'id': todolist.id}) }}"class="btn btn-primary mb-2">edit</a>

    {{ include('todolist/_delete_form.html.twig') }}
{% endblock %}
