{% extends 'base.html.twig' %}

{% block title %}Todolist{% endblock %}

{% block body %}
    <h1>Todolist</h1>

   
 <table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Utilisateur</th>
            <th>Nom de la liste</th>
            <th>Liste</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>{{ todolist.id }}</td>
            <td>{{ todolist.make }}</td>
            <td>{{ todolist.name}}</td>
            <td>{{ todolist.listing }}</td>
        </tr>
    </tbody>
</table>

    <a href="{{ path('app_todolist_index') }}"class="btn btn-primary mb-2">Retourner à la liste</a>

    <br>

    <a href="{{ path('app_todolist_edit', {'id': todolist.id}) }}"class="btn btn-primary mb-2">Editer</a>

    {{ include('todolist/_delete_form.html.twig') }}
{% endblock %}
