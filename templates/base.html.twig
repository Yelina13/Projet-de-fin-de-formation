<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>

        {% block stylesheets %}
         
        <link rel="stylesheet" href="https://unpkg.com/bootstrap-table@1.22.1/dist/bootstrap-table.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
        <link rel="stylesheet" href="{{ asset("css/style.css") }}" />

        {% endblock %}

        {% block javascripts %}

        <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
        <script src="https://unpkg.com/bootstrap-table@1.22.1/dist/bootstrap-table.min.js"></script>
        <script src="https://unpkg.com/bootstrap-table@1.22.1/dist/locale/bootstrap-table-fr-FR.min.js"></script>

        {% endblock %}
            <link rel="shortcut icon" href="{{ asset("images/favicon-32x32.png") }}" type="favicon">

    </head>
    <body> 
    
    <!-- Nav -->
        
           
                
                  {% if is_granted('ROLE_ADMIN') %}
           <nav class="navbar navbar-expand-lg navbar-light" style="background-color: #16645F;" >

            <div class="container-fluid">
            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('app_main') }}"><i class="bi bi-house icon-lg"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white  " href="{{ path('app_sticker_index') }}"><i class="bi bi-tags icon-lg"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white  " href="{{ path('app_sticker_category_index') }}"><i class="bi bi-signpost-split icon-lg"></i></a>
                    </li>
                     <li class="nav-item">
                        <a class="nav-link text-white  " href="{{ path('app_sticker_item_index') }}"><i class="bi bi-ui-checks-grid icon-lg"></i></a>
                    </li>
                        <a class="nav-link text-white " href="{{ path('app_article_index') }}"><i class="bi bi-book icon-lg"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white " href="{{ path('app_article_category_index') }}"><i class="bi bi-book-half icon-lg"></i></a>
                    </li>
                      </li>
                       <li class="nav-item">
                        <a class="nav-link text-white " href="{{ path('app_todolist_index') }}"> <i class="bi bi-card-checklist icon-lg"></i></a>
                     </li>
                    <li class="nav-item">
                        <a class="nav-link  text-white" href="{{ path('app_user_index') }}"><i class="bi bi-people icon icon-lg"></i></a>
                    </li>
                </ul>
                
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button"
                                data-bs-toggle="dropdown">
                                <span>{{ app.user.email }}</span>                               
                            </a>
                            <ul class="dropdown-menu bg-danger">
                                <li><a class="dropdown-item text-white " href="{{ path('app_logout') }}">Déconnexion</a></li>
                            </ul>
                        </li>
                    </ul>
                     
            <!--barre de recherche peut être à fair en V2 -->
            
                 <!-- <form class="d-flex" action="#">
                    <input class="form-control form-control-sm me-2" name="search" type="search" placeholder="Rechercher...">
                    <button class="btn btn-outline-light" type="submit"><i class="bi bi-search"></i></button>
                 </form> -->
          

            </div>

        </div>
    </nav>
    
       
          {% endif %}

          {% if app.request.attributes.get('_route') == 'app_main' %}
            <img src="{{ asset("images/banniere.png") }}" width=100% alt="logo">
         {% else %}
            <div class="container text-center">      
       <img src="{{ asset("images/logo.png") }}" width=20% alt="logo">
       </div>
        {% endif %}
     
       
       

        <div class="container text-center">       
        {% block body %}
           
         {% endblock %}
        </div>


     <!-- Js pour que le message flash disparait automtiquement aprés son affichage-->
    <script>const alerts = document.querySelectorAll('[class*="alert-"]')
        for (const alert of alerts) {
        setTimeout( function() {
        const bootstrapAlert = bootstrap.Alert.getOrCreateInstance(alert);
        bootstrapAlert.close();
    }, 2000); }
     </script>

    

    </body>
</html>
