{% extends 'base.html.twig' %}

{% block title %}Page Principal{% endblock %}
{% block body %}
       


 <div class="container text-center ">
    <div class="row" >
      <div class="col-lg-12 text-center">
      </div>
      <div class="col-lg-3 col-sm-6 mb-4">
        <div class="card border-0 shadow rounded-xs pt-2 text-white " style="background-color: #16645F;height: 268px">
          <div class="card-body">
             <a class="nav-link text-white" href="{{ path('app_main') }}"><i class="bi bi-house icon-lg"></i></a>
            <h4 class="mt-4 mb-3">Accueil</h4>
