{% extends 'base.html.twig' %}

{% block title %}Sticker{% endblock %}

{% block body %}
    <h1>Etiquette</h1>

    <table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Utilisateur</th>
            <th>Objets</th>
            <th>Lieux</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>{{ sticker.id }}</td>
            <td>{{ sticker.craft }}</td>                
            <td>  {% for item in sticker.contains %}
                        {{ item }}
                    {% endfor %}
            </td>     
            <td>
                {{ sticker.isabout }}
            </td>
        </tr>
    </tbody>
</table>

     <a href="{{ path('app_sticker_edit', {'id': sticker.id}) }}"class="btn btn-success mb-2">Editer</a> 

          <br> 

     <a href="{{ path('app_sticker_index') }}"class="btn btn-primary mb-2">Retourner à la liste</a>


{{ include('sticker/_delete_form.html.twig') }}
{% endblock %}
