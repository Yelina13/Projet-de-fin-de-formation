{% extends 'base.html.twig' %}

{% block title %}Sticker index{% endblock %}

{% block body %}
    <h1>Sticker index</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Utilisateur</th>
            <th>Objets</th>
            <th>Lieux</th>
        </tr>
    </thead>
    <tbody>
        {% for sticker in stickers %}
            <tr>
                <td>{{ sticker.id }}</td>
                <td>{{ sticker.craft }}</td>
                <td>
                    {% for item in sticker.contains %}
                        {{ item }}
                    {% endfor %}
                </td>
                   <td>
                        {{ sticker.isabout }}
                </td>
            </tr>
        {% else %}
            <td>
                <a href="{{ path('app_sticker_show', {'id': sticker.id}) }}">show</a>
                <a href="{{ path('app_sticker_edit', {'id': sticker.id}) }}">edit</a>
            </td>
            <tr>
                <td colspan="4">No records found</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

    <a href="{{ path('app_sticker_new') }}">Create new</a>
{% endblock %}
