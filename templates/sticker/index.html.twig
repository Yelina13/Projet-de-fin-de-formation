{% extends 'base.html.twig' %}

{% block title %}Sticker index{% endblock %}

{% block body %}

    <h1>Sticker index <a class="btn btn-success" href="{{ path('app_sticker_new') }}">Create new</a></h1>


{% for message in app.flashes('info') %}
<div class="alert alert-success">
{{ message }}
</div>
{% endfor %}


<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Utilisateur</th>
            <th>Objets</th>
            <th>Lieux</th>
            <th>Visualiser</th>
            <th>Editer</th>

        </tr>
    </thead>
    <tbody>
        {% for sticker in stickers %}
            <tr>
                <td>{{ sticker.id }}</td>
                <td>{{ sticker.craft }}</td>
                <td>
                    {% for item in sticker.contains %}
                        {{ item }}
                    {% endfor %}
                </td>
                <td>
                        {{ sticker.isabout }}
                </td>
               <td>
                 <a  href="{{ path('app_sticker_show', {'id': sticker.id}) }}"><i class="bi bi-eye-fill style" style="font-size: 2rem; color: green" ></i></a>
                 </td>
                <td>
                 <a  href="{{ path('app_sticker_edit', {'id': sticker.id}) }}"><i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
                </td>
           </tr>
        {% endfor %}
    </tbody>
</table>
   
{% endblock %}
