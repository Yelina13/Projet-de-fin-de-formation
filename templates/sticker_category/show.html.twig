{% extends 'base.html.twig' %}

{% block title %}StickerCategory{% endblock %}

{% block body %}
    <h1>Categorie d'étiquette</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ sticker_category.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ sticker_category.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_sticker_category_edit', {'id': sticker_category.id}) }}"class="btn btn-success mb-2">Editer</a>

    <br>

    <a href="{{ path('app_sticker_category_index') }}"class="btn btn-primary mb-2">Retourner à la liste</a>

    {{ include('sticker_category/_delete_form.html.twig') }}
{% endblock %}
