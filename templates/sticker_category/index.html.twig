{% extends 'base.html.twig' %}

{% block title %}StickerCategory index{% endblock %}

{% block body %}
    <h1>StickerCategory index <a class="btn btn-success" href="{{ path('app_sticker_category_new') }}">Create new</a></h1>

    {% for message in app.flashes('info') %}
    <div class="alert alert-success">
    {{ message }}
    </div>
    {% endfor %}


    <table class="table table-hover">
        <thead>
            <tr>
                <th>Id</th>

            </tr>
        </thead>
        <tbody>
        {% for sticker_category in sticker_categories %}
            <tr>
                <td>{{ sticker_category.id }}</td>
                <td>{{ sticker_category.name }}</td>
                <td>

                </td>
                <td>    
                    <a  href="{{ path('app_sticker_category_edit', {'id': sticker_category.id}) }}"><i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
                </td>
            </tr>  
        {% endfor %}
        </tbody>
    </table>


{% endblock %}
