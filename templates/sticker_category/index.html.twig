{% extends 'base.html.twig' %}

{% block title %}StickerCategory index{% endblock %}

{% block body %}
    <h1>StickerCategory index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for sticker_category in sticker_categories %}
            <tr>
                <td>{{ sticker_category.id }}</td>
                <td>{{ sticker_category.name }}</td>
                <td>
                    <a  href="{{ path('app_sticker_category_show', {'id': sticker_category.id}) }}"><i class="bi bi-eye-fill style" style="font-size: 2rem; color: green"  ></i></a>
                </td>
                <td>    
                    <a  href="{{ path('app_sticker_category_edit', {'id': sticker_category.id}) }}"><i class="bi bi-pencil-square" style="font-size: 2rem; color: green"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
<a class="btn btn-success" href="{{ path('app_sticker_category_new') }}">Create new</a>
   
{% endblock %}
