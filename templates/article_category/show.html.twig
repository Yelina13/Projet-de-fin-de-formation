{% extends 'base.html.twig' %}

{% block title %}ArticleCategory{% endblock %}

{% block body %}
    <h1>Catégorie d'article</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ article_category.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ article_category.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_article_category_edit', {'id': article_category.id}) }}"class="btn btn-success mb-2">Editer</a>

    <br>

    <a href="{{ path('app_article_category_index') }}"class="btn btn-primary mb-2">Retourner à la liste</a>

    {{ include('article_category/_delete_form.html.twig') }}
{% endblock %}
