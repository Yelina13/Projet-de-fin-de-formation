{% extends 'base.html.twig' %}

{% block title %}StickerItem{% endblock %}

{% block body %}
    <h1>Objet de l'étiquette</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ sticker_item.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
